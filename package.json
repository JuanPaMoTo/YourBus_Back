{
  "name": "yourbus-back",
  "version": "1.0.0",
  "description": "Backend de YourBus: rutas, paraderos, horarios, ubicacion y ETA de buses.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src tests",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage=false",
    "test:watch": "jest --watch",
    "db:seed": "node src/seed.js",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "audit": "npm audit --omit=dev --audit-level=high",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "{src,tests}/**/*.js": [
      "eslint",
      "prettier --write"
    ]
  },
  "keywords": [
    "yourbus",
    "transporte",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "braces": "^3.0.3"
  }
}