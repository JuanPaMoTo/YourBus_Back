PORT=4000
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma (uno por entorno)
CORS_ORIGIN=http://localhost:5173,https://yourbus-front-qa.azurewebsites.net,https://yourbus-front.azurewebsites.net

# Conexión a MongoDB Atlas. Usa una base distinta por entorno dentro del
# mismo cluster (yourbus_dev / yourbus_qa / yourbus_prod), reemplazando el
# nombre de la base al final de la URL antes del "?".
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.qupzcwo.mongodb.net/yourbus_dev?appName=Cluster0
